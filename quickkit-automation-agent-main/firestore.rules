rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profile identity and authorization role are server-managed. New users
    // may create only their own ordinary USER profile; clients cannot self-promote.
    function validUserProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'USER'
        // Signup may create only the exact default FREE profile produced by
        // services/userService.ts. Entitlements and payment metadata are server-managed.
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'tier', 'region', 'role', 'status', 'expiresAt',
          'updatedAt', 'autoRenew', 'credits', 'aiUsed', 'monthlyLimit',
          'usage', 'warningSent', 'createdAt', 'onboardingDone'
        ])
        && request.resource.data.email is string
        && (
          request.resource.data.email == ''
          || request.resource.data.email == request.auth.token.email
        )
        && request.resource.data.tier == 'FREE'
        && request.resource.data.region in ['IN', 'GLOBAL']
        && request.resource.data.status == 'active'
        && request.resource.data.expiresAt == 0
        && request.resource.data.autoRenew == false
        && request.resource.data.credits == 5
        && request.resource.data.aiUsed == 0
        && request.resource.data.monthlyLimit == 5
        && request.resource.data.usage is map
        && request.resource.data.usage.keys().hasOnly(['workflows', 'runs', 'apiCalls'])
        && request.resource.data.usage.workflows == 0
        && request.resource.data.usage.runs == 0
        && request.resource.data.usage.apiCalls == 0
        && request.resource.data.warningSent == false
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.onboardingDone == false;
    }

    function validUserProfileUpdate(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      // The client profile service only writes lastLoginAt, onboardingDone and
      // updatedAt. Credits, usage, quotas, plans, payment and identity fields
      // are server-managed and must never be writable from a client SDK.
      return isOwner(userId)
        && changedKeys.hasOnly(['lastLoginAt', 'onboardingDone', 'updatedAt'])
        && (!changedKeys.hasAny(['lastLoginAt']) || request.resource.data.lastLoginAt is int)
        && (!changedKeys.hasAny(['onboardingDone']) || request.resource.data.onboardingDone is bool)
        && (!changedKeys.hasAny(['updatedAt']) || request.resource.data.updatedAt is int);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if validUserProfileCreate(userId);
      allow update: if validUserProfileUpdate(userId);
      allow delete: if false;
    }

    function validProjectCreate(projectId) {
      return projectId != 'test-project'
        && isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'description', 'createdAt', 'updatedAt',
          'nexuses', 'synapses', 'settings'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'title', 'description', 'createdAt', 'updatedAt',
          'nexuses', 'synapses', 'settings'
        ])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.nexuses is list
        && request.resource.data.synapses is list
        && request.resource.data.settings is map;
    }

    function validProjectUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        // Clients may save workflow graphs and client-owned settings only.
        // Project status, payment state, price and ownership remain server-managed.
        && changedKeys.hasOnly(['nexuses', 'synapses', 'settings', 'updatedAt'])
        && (!changedKeys.hasAny(['nexuses']) || request.resource.data.nexuses is list)
        && (!changedKeys.hasAny(['synapses']) || request.resource.data.synapses is list)
        && (!changedKeys.hasAny(['settings']) || request.resource.data.settings is map)
        && (!changedKeys.hasAny(['updatedAt']) || request.resource.data.updatedAt is int);
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if validProjectCreate(projectId);
      allow update: if validProjectUpdate();
      allow delete: if isOwner(resource.data.userId);
    }

    // Active run checkpoints are private to the signed-in owner.
    // Clients may create/read/update their own run state, but cannot enumerate runs,
    // change ownership/project identity, or write arbitrary fields.
    function validActiveRunShape(runId) {
      return request.resource.data.keys().hasOnly([
        'runId', 'userId', 'projectId', 'status', 'currentQueue',
        'completedNodeIds', 'context', 'startTime', 'lastUpdateTime',
        'nodeLimitCount', 'createdAt'
      ])
        && request.resource.data.keys().hasAll([
          'runId', 'userId', 'projectId', 'status', 'currentQueue',
          'completedNodeIds', 'context', 'startTime', 'lastUpdateTime',
          'nodeLimitCount'
        ])
        && request.resource.data.runId == runId
        && request.resource.data.userId is string
        && request.resource.data.projectId is string
        && request.resource.data.status in ['QUEUED', 'RUNNING', 'PAUSED', 'COMPLETED', 'FAILED']
        && request.resource.data.currentQueue is list
        && request.resource.data.completedNodeIds is list
        && request.resource.data.context is map
        && request.resource.data.startTime is int
        && request.resource.data.lastUpdateTime is int
        && request.resource.data.nodeLimitCount is int
        && request.resource.data.nodeLimitCount >= 0
        && (!('createdAt' in request.resource.data)
          || request.resource.data.createdAt is timestamp);
    }

    function validActiveRunProjectReference(projectId) {
      let projectPath = /databases/$(database)/documents/projects/$(projectId);
      return exists(projectPath)
        && get(projectPath).data.userId == request.auth.uid;
    }

    function validActiveRunCreate(runId) {
      return isOwner(request.resource.data.userId)
        && validActiveRunShape(runId)
        && validActiveRunProjectReference(request.resource.data.projectId)
        // createCloudRun uses a Firestore server timestamp; local checkpoints
        // may create the same shape without the optional createdAt field.
        && (!('createdAt' in request.resource.data)
          || request.resource.data.createdAt == request.time);
    }

    function validActiveRunUpdate(runId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.projectId == resource.data.projectId
        && validActiveRunShape(runId)
        && changedKeys.hasOnly([
          'status', 'currentQueue', 'completedNodeIds', 'context',
          'lastUpdateTime', 'nodeLimitCount'
        ]);
    }

    match /active_runs/{runId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if false;
      allow create: if validActiveRunCreate(runId);
      allow update: if validActiveRunUpdate(runId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Architect memory is private to its creator. Legacy unowned records are not exposed.
    function validArchitectMemoryCreate() {
      return isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'userPrompt', 'blueprintSummary', 'fullBlueprint', 'createdAt', 'likes'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'userPrompt', 'blueprintSummary', 'fullBlueprint', 'createdAt', 'likes'
        ])
        && request.resource.data.userPrompt is string
        && request.resource.data.userPrompt.size() <= 8000
        && request.resource.data.blueprintSummary is string
        && request.resource.data.blueprintSummary.size() <= 500
        && request.resource.data.fullBlueprint is map
        && request.resource.data.fullBlueprint.keys().hasOnly(['nexuses', 'synapses'])
        && request.resource.data.fullBlueprint.keys().hasAll(['nexuses', 'synapses'])
        && request.resource.data.fullBlueprint.nexuses is list
        && request.resource.data.fullBlueprint.synapses is list
        && request.resource.data.createdAt is int
        && request.resource.data.likes == 1;
    }

    match /architect_memory/{memoryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if validArchitectMemoryCreate();
      allow update, delete: if false;
    }

    // Execution logs are client-created, but every record is permanently scoped to its verified owner.
    // Clients may read their own logs and create new ones; existing logs cannot be altered or deleted.
    function validExecutionLogCreate() {
      return isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id', 'timestamp', 'nexusId', 'status', 'message', 'duration',
          'inputData', 'outputData', 'usage', 'userId', 'createdAt'
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 128
        && request.resource.data.timestamp is int
        && request.resource.data.nexusId is string
        && request.resource.data.nexusId.size() <= 128
        && request.resource.data.status in ['success', 'error', 'retrying']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.duration is int
        && request.resource.data.duration >= 0
        && request.resource.data.createdAt == request.time
        && (!('inputData' in request.resource.data)
          || (request.resource.data.inputData is string && request.resource.data.inputData.size() <= 100000))
        && (!('outputData' in request.resource.data)
          || (request.resource.data.outputData is string && request.resource.data.outputData.size() <= 100000))
        && (!('usage' in request.resource.data)
          || (
            request.resource.data.usage is map
            && request.resource.data.usage.keys().hasOnly(['tokens', 'creditsCost'])
            && (!('tokens' in request.resource.data.usage)
              || (request.resource.data.usage.tokens is int && request.resource.data.usage.tokens >= 0))
            && (!('creditsCost' in request.resource.data.usage)
              || (request.resource.data.usage.creditsCost is int && request.resource.data.usage.creditsCost >= 0))
          ));
    }

    match /execution_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if validExecutionLogCreate();
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
