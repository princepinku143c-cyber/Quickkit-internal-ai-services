# QuickKit AI production environment template
# Replace every placeholder only in the deployment platform's environment settings.
# Never commit real credentials to this repository.

# Firebase Admin (server only)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key_with_\\n_newlines"

# Firebase client
# These four values are required before Firebase Auth/Firestore initialize.
VITE_FIREBASE_API_KEY=your_vite_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_vite_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_vite_firebase_project_id
VITE_FIREBASE_APP_ID=your_vite_firebase_app_id

# Optional Firebase client services; populate when enabled for this project.
VITE_FIREBASE_STORAGE_BUCKET=your_vite_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_vite_firebase_messaging_sender_id
VITE_FIREBASE_MEASUREMENT_ID=your_vite_firebase_measurement_id

# Lead notification mail
EMAIL_USER=your_smtp_email
EMAIL_PASS=your_smtp_app_password
LEAD_NOTIFY_EMAIL=admin@quickkitai.com

# AEO Python agent (server only; required when agents/aeo_agent.py is deployed)
OPENCODE_API_KEY=your_opencode_api_key

# Optional provider admin integration (only if used by deployment tooling)
OPENROUTER_ADMIN_KEY=your_openrouter_admin_key
