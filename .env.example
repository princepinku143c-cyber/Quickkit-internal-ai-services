# AI INFRASTRUCTURE
NEURAL_NODE_KEY=your_deepseek_api_key_here
NEURAL_NODE_ENGINE=deepseek-chat
NEURAL_NODE_ENDPOINT=https://api.deepseek.com/chat/completions
TAVILY_API_KEY=your_tavily_api_key

# FIREBASE CONFIGURATION (Server Side)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key_with_\n_newlines"

# FIREBASE CONFIGURATION (Client Side)
# apiKey, authDomain, projectId, and appId are required by lib/firebaseConfig.js.
VITE_FIREBASE_API_KEY=your_vite_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_vite_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_vite_firebase_project_id
VITE_FIREBASE_APP_ID=your_vite_firebase_app_id

# EMAIL CONFIGURATION (For Lead Alerts)
EMAIL_USER=your_smtp_email
EMAIL_PASS=your_smtp_password
ADMIN_EMAIL=admin_receiving_email

# PAYMENTS
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# TELEGRAM BOT CONFIGURATION
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id_or_group_id

# BREVO EMAIL API CONFIGURATION
BREVO_API_KEY=your_brevo_api_key

# VPS automation server (set only on the VPS; never expose via VITE_ variables)
VPS_AUTOMATION_TOKEN=generate_a_long_random_secret

# Optional AEO API; disabled unless explicitly enabled after provider/cost approval.
# AEO_API_ENABLED=false
# Optional AEO agent provider key; leave unset to keep the agent disabled.
# Leave these unset until a paid Console or eligible Go model is approved.
# OPENCODE_API_KEY=
# OPENCODE_API_ENDPOINT=https://opencode.ai/inference/openai/v1/chat/completions
# OPENCODE_MODEL=your_approved_paid_or_go_model_id
