{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*).(js|css|woff2|png|svg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/privacy-policy",
      "destination": "https://quickkitai.com/privacy",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "https://quickkitai.com/terms",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.quickkitai.com"
        }
      ],
      "destination": "https://quickkitai.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/services/real-estate",
      "destination": "/services/real-estate/index.html"
    },
    {
      "source": "/services/real-estate/",
      "destination": "/services/real-estate/index.html"
    },
    {
      "source": "/services/healthcare",
      "destination": "/services/healthcare/index.html"
    },
    {
      "source": "/services/healthcare/",
      "destination": "/services/healthcare/index.html"
    },
    {
      "source": "/guides/real-estate-ai-lead-qualification",
      "destination": "/guides/real-estate-ai-lead-qualification/index.html"
    },
    {
      "source": "/guides/real-estate-ai-lead-qualification/",
      "destination": "/guides/real-estate-ai-lead-qualification/index.html"
    },
    {
      "source": "/real-estate-ai-questions",
      "destination": "/real-estate-ai-questions/index.html"
    },
    {
      "source": "/real-estate-ai-questions/",
      "destination": "/real-estate-ai-questions/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/about/",
      "destination": "/about/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact/index.html"
    },
    {
      "source": "/ai-visibility",
      "destination": "/ai-visibility/index.html"
    },
    {
      "source": "/ai-visibility/",
      "destination": "/ai-visibility/index.html"
    },
    {
      "source": "/seo-audit",
      "destination": "/seo-audit/index.html"
    },
    {
      "source": "/seo-audit/",
      "destination": "/seo-audit/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms/index.html"
    },
    {
      "source": "/((?!assets/|sitemap\\.xml|robots\\.txt|llms\\.txt|favicon|services/real-estate(?:/.*)?$|services/healthcare(?:/.*)?$|guides/real-estate-ai-lead-qualification(?:/.*)?$|real-estate-ai-questions(?:/.*)?$|blog(?:/.*)?$|about(?:/.*)?$|contact(?:/.*)?$|seo-audit(?:/.*)?$|privacy(?:/.*)?$|terms(?:/.*)?$).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci"
}
