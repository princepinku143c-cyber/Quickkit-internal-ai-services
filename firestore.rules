rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && userId == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validClientProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'client'
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'credits', 'plan',
          'createdAt', 'updatedAt', 'updated_at'
        ])
        && (!('email' in request.resource.data)
          || request.resource.data.email == request.auth.token.email)
        && (!('credits' in request.resource.data)
          || request.resource.data.credits == 500)
        && (!('plan' in request.resource.data)
          || request.resource.data.plan == 'free');
    }

    function validWebhookSecretUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['webhookSecret'])
        || (
          request.resource.data.webhookSecret is string
          && request.resource.data.webhookSecret.matches('^[a-f0-9]{64}$')
        );
    }

