rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users may update ordinary profile fields only. Privileged and identity
    // fields are managed by trusted server code using the Admin SDK.
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAdmin();
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'uid', 'role', 'credits', 'plan', 'tier', 'status', 'provider',
            'monthlyLimit', 'admin', 'isAdmin', 'permissions', 'billingStatus',
            'subscriptionId', 'createdAt', 'tenantId', 'workspaceId'
          ]);
      allow delete: if false;
    }

    // Public lead intake is handled by the server API (Admin SDK).
    match /leads/{leadId} {
      // Client workspaces currently have read-only lead views. Public intake and
      // lead lifecycle mutations are performed by trusted server code or the
      // admin dashboard, so client-side writes are not permitted.
      allow create: if isAdmin();
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Client project creation goes through the trusted API. Direct Firestore
      // creation is reserved for the admin dashboard to prevent clients from
      // self-assigning privileged billing or project lifecycle fields.
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /logs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() && request.resource.data.userId is string;
      allow update, delete: if false;
    }

    match /agents/{agentId} {
      allow read, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['tenantId', 'workspaceId']);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['tenantId', 'workspaceId']);
    }

    match /leads_outreach/{leadId} {
      allow read, write: if isAdmin();
    }
  }
}
