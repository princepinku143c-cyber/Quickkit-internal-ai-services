rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users may create only ordinary client profiles. Privileged fields can
    // only be changed by trusted server code using the Admin SDK.
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'client';
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'credits', 'plan', 'tier', 'status', 'provider']);
      allow delete: if false;
    }

    // Public lead intake is handled by the server API (Admin SDK). Direct
    // Firestore writes are reserved for authenticated administrators.
    match /leads/{leadId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /logs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() && request.resource.data.userId is string;
      allow update, delete: if false;
    }

    match /agents/{agentId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    match /leads_outreach/{leadId} {
      allow read, write: if isAdmin();
    }
  }
}