{
  "name": "quickkit-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-public-routes.mjs",
    "preview": "vite preview",
    "test:api": "node tests/api-test.js",
    "test:api-guard": "node tests/api-integration-guard.test.js",
    "test:lead-idempotency": "node tests/lead-idempotency.test.js",
    "validate:seo": "node scripts/validate-seo-assets.mjs",
    "validate:prerender": "node scripts/validate-prerendered-pages.mjs",
    "test:seo": "npm run validate:seo && npm run validate:prerender",
    "test:security": "node tests/input-test.js && node tests/payment-token.test.js && node tests/private-key-material.test.mjs",
    "test:rank-tracker": "node tests/rank-tracker.test.js",
    "test:cron-auth": "node tests/cron-auth.test.js",
    "test:aeo-api": "node tests/aeo-api.test.js",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project demo-quickkitai-rules \"node tests/firestore-rules.test.mjs\"",
    "test:automation-run-context": "node tests/automation-run-context.test.mjs",
    "test:client-gemini-secret-boundary": "node tests/client-gemini-secret-boundary.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "firebase": "^12.8.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.562.0",
    "nodemailer": "^10.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^3.0.0",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^7.13.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "jwks-rsa": "2.1.5"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true
  }
}
